# Botun bağlanacağı sunucu. Kendi bilgisayarındaki sunucu için localhost bırak.
MC_HOST=localhost
MC_PORT=25565

# Minecraft sürümü. Sunucunla AYNI olmalı.
MC_VERSION=1.20.4

# Botun oyundaki adı. Offline-mode sunucuda istediğin ismi verebilirsin.
MC_USERNAME=MinecrAI

# 'offline' = şifresiz yerel sunucu (bizim kullandığımız)
# 'microsoft' = gerçek hesapla premium sunucuya bağlanmak istersen
MC_AUTH=offline

# Python köprüsünün dinleyeceği port (Milestone 2+)
BRIDGE_PORT=8765

# ---- SOHBET KATMANI (isteğe bağlı) ----
# Doldurursan bota oyun içinde normal Türkçe yazabilirsin:
#   "bana bir taş kazma yapar mısın"  -> uret tas kazma
#   "3 tane daha kes"                 -> kes 3
#   "ne var envanterinde"             -> envanterinden cevap verir
#
# BOŞ BIRAKIRSAN sohbet kapalı kalır ve bot tam komutlarla
# ("kes 3", "uret tas kazma") eskisi gibi çalışır. Zorunlu değil.
#
# İKİSİNDEN BİRİNİ doldur, hangisi doluysa o kullanılır.

# Google Gemini — ÜCRETSİZ katmanı var, para gerekmiyor.
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — ücretli. Mesaj başına kabaca 0.001 dolar.
# Anahtar: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# İkisi de doluysa hangisi kullanılsın? Boş bırakırsan Gemini (ücretsiz).
# Değerler: gemini | anthropic
SOHBET_SAGLAYICI=

# Model. Boş bırakırsan sağlayıcının en ucuz/hızlı varsayılanı kullanılır
# (gemini-3.5-flash-lite / claude-haiku-4-5-20251001).
SOHBET_MODELI=
