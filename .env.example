# Minecraft sunucusu
MC_HOST=localhost
MC_PORT=25565

# Sunucu sürümüyle eşleşmeli.
MC_VERSION=1.20.4

MC_USERNAME=MinecrAI

# offline: yerel sunucu; microsoft: premium hesap
MC_AUTH=offline

BRIDGE_PORT=8765

# Yalnızca metadata; davranışı değiştirmez.
MINECRAI_PROFILE=vanilla-survival

# İsteğe bağlı sohbet; anahtar yoksa tam komutlar çalışır.
GEMINI_API_KEY=

ANTHROPIC_API_KEY=

# gemini | anthropic; boşsa otomatik seçim
SOHBET_SAGLAYICI=

# Boşsa sağlayıcının varsayılan modeli.
SOHBET_MODELI=
